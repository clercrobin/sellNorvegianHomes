# ========================================
# NordMaison - Environment Variables
# ========================================

# Email Configuration
# Choose one: "resend", "sendgrid", "brevo", or "console" (for testing)
EMAIL_PROVIDER=console
EMAIL_API_KEY=your-api-key-here
EMAIL_FROM=contact@nordmaison.fr
EMAIL_TO=sales@nordmaison.fr

# Resend API (Recommended)
# Sign up at: https://resend.com
# Free tier: 100 emails/day
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# SendGrid API (Alternative)
# Sign up at: https://sendgrid.com
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# Brevo API (French company, formerly Sendinblue)
# Sign up at: https://brevo.com
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxx

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel (Facebook/Instagram Ads)
NEXT_PUBLIC_META_PIXEL_ID=1234567890

# Live Chat - Tawk.to
NEXT_PUBLIC_TAWK_PROPERTY_ID=xxxxxxxxxxxxx
NEXT_PUBLIC_TAWK_WIDGET_ID=xxxxxxxxxxxxx

# Error Tracking - Sentry (Optional)
SENTRY_DSN=https://xxxxxxxxxxxxx@sentry.io/xxxxxxxxxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxx@sentry.io/xxxxxxxxxxxxx

# Database (Optional - for lead storage)
# Supabase
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxx

# or PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/nordmaison

# Deployment
NEXT_PUBLIC_SITE_URL=https://nordmaison.fr
VERCEL_URL=nordmaison.vercel.app

# Security
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-change-in-production
